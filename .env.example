# Resend API key used server-side only (src/app/api/lead/route.ts) to send
# the book-a-demo lead email. Never referenced from client code.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Resend sender identity. Falls back to Resend's shared sandbox
# sender (onboarding@resend.dev) if unset — fine for testing, not for
# production deliverability.
RESEND_FROM_EMAIL="Zamili Leads <leads@your-verified-domain.com>"

# Where lead-form submissions are emailed to. Server-side only — the CI
# check in scripts/check-no-lead-email-leak.mjs fails the build if this
# value ever ends up inside .next/ (the client bundle).
LEAD_EMAIL=you@example.com
